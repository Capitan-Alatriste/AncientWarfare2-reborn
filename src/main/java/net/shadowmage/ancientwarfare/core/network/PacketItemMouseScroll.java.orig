package net.shadowmage.ancientwarfare.core.network;

import net.minecraft.network.FriendlyByteBuf;
import net.minecraft.network.codec.ByteBufCodecs;
import net.minecraft.network.codec.StreamCodec;
import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.world.entity.player.Player;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;

public record PacketItemMouseScroll(boolean scrollUp) implements PacketBase {

    public static final CustomPacketPayload.Type<PacketItemMouseScroll> TYPE = new CustomPacketPayload.Type<>(ResourceLocation.fromNamespaceAndPath("ancientwarfare", "item_mouse_scroll"));

    public static final StreamCodec<FriendlyByteBuf, PacketItemMouseScroll> CODEC = StreamCodec.composite(
            ByteBufCodecs.BOOL, PacketItemMouseScroll::scrollUp,
            PacketItemMouseScroll::new
    );

    @Override
    public Type<? extends CustomPacketPayload> type() {
        return TYPE;
    }

    @Override
    public void execute(Player player) {
        ItemStack stack = player.getMainHandItem();
        Item item = stack.getItem();

        // TODO Phase 6 (Input): Re-enable scrollable item handling when input interfaces are migrated
        /*
        if (item instanceof net.shadowmage.ancientwarfare.core.input.IScrollableItem scrollableItem) {
            if (scrollUp) {
                scrollableItem.onScrollUp(player.level(), player, stack);
            } else {
                scrollableItem.onScrollDown(player.level(), player, stack);
            }
        }
        */
    }
}
